NODE_ENV=development

# Database
# Neon hosted setup: DATABASE_URL is the pooled endpoint (host contains -pooler);
# DATABASE_MIGRATION_URL is the direct endpoint for Prisma migrations. Both require TLS.
# Local Docker URLs below remain available for offline development.
DATABASE_URL=postgresql://railgrid:railgrid@localhost:5432/railgrid
DATABASE_MIGRATION_URL=postgresql://railgrid_migrator:railgrid@localhost:5432/railgrid

# Redis
REDIS_URL=redis://localhost:6379
QUEUE_REDIS_URL=redis://localhost:6380

# Auth
JWT_ACCESS_SECRET=changeme-at-least-32-characters-long
REFRESH_TOKEN_PEPPER=changeme-at-least-32-characters-long
OUTBOX_ENCRYPTION_KEY=changeme-at-least-32-characters-long
COOKIE_DOMAIN=localhost
ALLOWED_ORIGINS=http://localhost:3000

# Razorpay (test mode only)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Train data provider
TRAIN_DATA_PROVIDER=fixture
RAILRADAR_API_KEY=
RAILRADAR_MONTHLY_BUDGET=100
RAILRADAR_MINUTE_LIMIT=10

# Email
RESEND_API_KEY=

# Bot protection
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Booking config
HOLD_TTL_SECONDS=600
PAYMENT_EXTENSION_SECONDS=300
BOOKING_WINDOW_DAYS=60

# Observability
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# API
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
